{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/workerman/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/workerman/data/:version([a-f0-9]{16})/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/data/:version([a-f0-9]{16})/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/workerman/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/workerman/data/:path*", "destination": "/data/:path*" },
    { "source": "/workerman/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/workerman", "destination": "/index.html" },
    { "source": "/workerman/:path((?!assets/|data/).*)", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
